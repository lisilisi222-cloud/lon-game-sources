<Application x:Class="L0N.Launcher.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBg" Color="#14171C"/>
    <SolidColorBrush x:Key="MainBg" Color="#0D0F12"/>
    <SolidColorBrush x:Key="EdgeLine" Color="#292E35"/>
    <SolidColorBrush x:Key="BrightText" Color="#F4F7FA"/>
    <SolidColorBrush x:Key="MutedText" Color="#9CA8B5"/>
    <SolidColorBrush x:Key="BlueAccent" Color="#19A7FF"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource BrightText}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource BrightText}"/><Setter Property="Background" Value="#1C2229"/>
      <Setter Property="BorderBrush" Value="#303841"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#2396D9"/><Setter TargetName="Chrome" Property="Background" Value="#26333D"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#087FCE"/><Setter Property="BorderBrush" Value="#188DCE"/></Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="19,13"/><Setter Property="Margin" Value="0,3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#14171C"/><Setter Property="BorderBrush" Value="#383E47"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,10"/><Setter Property="CaretBrush" Value="#42B7FF"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#20252C"/><Setter Property="BorderBrush" Value="#31373F"/><Setter Property="Padding" Value="6"/><Setter Property="MinHeight" Value="37"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DFE7EE"/><Setter Property="Margin" Value="0,7"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#13161A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#303640"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="4"/><Setter Property="Background" Value="Transparent"/></Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#B5C4CF"/><Setter Property="Background" Value="#15191E"/><Setter Property="Margin" Value="4"/><Setter Property="MinWidth" Value="165"/><Setter Property="MinHeight" Value="47"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="#242C34" BorderThickness="1" CornerRadius="8" Margin="3">
          <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15,10"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#0D4262"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="#2195D2"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#4B7D97"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="#1BAAF2"/><Setter Property="Background" Value="#2A3036"/></Style>
  </Application.Resources>
</Application>
